# Copy to .env; never commit .env
POSTGRES_DB=klemmbaustein_inventory
POSTGRES_USER=klemmbaustein
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# API key from https://rebrickable.com/api/ (server side only)
REBRICKABLE_API_KEY=
# GHCR-Deployment: latest oder ein veröffentlichter Kurz-Commit, z. B. 14f494d
IMAGE_TAG=latest
# Öffentlich erreichbarer HTTP-Port des Webdienstes
WEB_PORT=8080
