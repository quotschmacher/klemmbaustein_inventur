{
  "name": "Klemmbaustein Inventur Dev (Python + Node + PostgreSQL)",
  "dockerComposeFile": ["../compose.dev.yaml"],
  "service": "workspace",
  "runServices": ["db", "workspace"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000, 5173],
  "postCreateCommand": "python -m pip install -e '/workspace/backend[dev]' && npm ci --prefix /workspace/frontend",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "vscode"
}
